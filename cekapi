<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Test Koneksi Firebase</title>
</head>
<body>
    <h2>Uji Koneksi Firebase (`bns-kurir`)</h2>
    <p>Cek hasil koneksi di <strong>Console Browser</strong> (tekan F12 > pilih tab Console).</p>
    
    <div id="status" style="font-weight: bold; margin-top: 20px;">Menghubungkan ke Firebase...</div>

    <!-- Script Firebase SDK via CDN -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
        import { getDatabase, ref, get } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        // Konfigurasi Anda
        const firebaseConfig = {
            apiKey: "AIzaSyBUSWK7ykh99naQExKfHKJZB1oOYvlrUzU",
            authDomain: "bns-kurir.firebaseapp.com",
            databaseURL: "https://bns-kurir-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "bns-kurir",
            storageBucket: "bns-kurir.firebasestorage.app",
            messagingSenderId: "510833854736",
            appId: "1:510833854736:web:13dda6eb2694b81533bd95",
            measurementId: "G-TRW8ED7VQX"
        };

        const statusEl = document.getElementById("status");

        try {
            // Inisialisasi Firebase
            const app = initializeApp(firebaseConfig);
            const auth = getAuth(app);
            const db = getDatabase(app);

            console.log("Firebase berhasil diinisialisasi!");

            // Uji Auth
            onAuthStateChanged(auth, (user) => {
                if (user) {
                    console.log("Auth Status: User login sebagai", user.email);
                } else {
                    console.log("Auth Status: Terhubung (Tidak ada user yang aktif/login).");
                }
            });

            // Uji Realtime Database
            const testRef = ref(db, '/');
            get(testRef)
                .then((snapshot) => {
                    console.log("Database Status: BERHASIL terhubung ke server!");
                    statusEl.innerText = "Koneksi Berhasil! Cek Console (F12) untuk detail.";
                    statusEl.style.color = "green";
                })
                .catch((error) => {
                    console.error("Database Gagal Terhubung:", error.code, error.message);
                    statusEl.innerText = "Gagal terhubung: " + error.message;
                    statusEl.style.color = "red";
                });

        } catch (error) {
            console.error("Inisialisasi Error:", error);
            statusEl.innerText = "Terjadi kesalahan inisialisasi: " + error.message;
            statusEl.style.color = "red";
        }
    </script>
</body>
</html>
